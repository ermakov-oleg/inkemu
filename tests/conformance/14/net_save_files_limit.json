{
  "spec": "§14",
  "about": "a save to the app folder takes 8388608 bytes; one more is saved = false with err = limit_exceeded and no file",
  "manifest": {
    "permissions": [
      "net"
    ]
  },
  "fixtures": [
    {
      "method": "GET",
      "url": "https://s.test/max",
      "status": 200,
      "delay_ms": 10,
      "body_repeat": [
        "x",
        8388608
      ]
    },
    {
      "method": "GET",
      "url": "https://s.test/over",
      "status": 200,
      "delay_ms": 10,
      "body_repeat": [
        "x",
        8388609
      ]
    }
  ],
  "steps": [
    "wait 6s"
  ],
  "expect": {
    "max_saved": {
      "value": true,
      "spec": "§14"
    },
    "max_err": {
      "value": "nil",
      "spec": "§14"
    },
    "max_size": {
      "value": 8388608,
      "spec": "§14"
    },
    "over_ok": {
      "value": true,
      "spec": "§14"
    },
    "over_saved": {
      "value": false,
      "spec": "§14"
    },
    "over_bytes": {
      "value": 8388609,
      "spec": "§14"
    },
    "over_err": {
      "value": "limit_exceeded",
      "spec": "§14"
    },
    "over_exists": {
      "value": false,
      "spec": "§14"
    }
  },
  "errors": []
}
